# Terraform working directories and state
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
plan.out

# Real variable files and backend configs stay local; only *.example files are committed
*.tfvars
*.tfvars.json
!*.tfvars.example
backend.hcl
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Never commit credentials
*.json.key
*-key.json
credentials.json

# Tooling
.tflint.d/
.terraform.d/
.DS_Store
.idea/
.vscode/

# Lock files are committed for root configurations (envs/) only, not for reusable modules
modules/**/.terraform.lock.hcl
